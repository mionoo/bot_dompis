# Jadwal otomatis WO HI setiap 2 jam (WIB); 00:00 merekap hari sebelumnya melalui antrean test.js.
# Command manual /teswohi tetap dapat dipakai saat jadwal nonaktif.
WOHI_ENABLED=0
# Opsional: jika tidak diatur, memakai FFG_MYSQL_* existing.
# Isi hanya jika database/kredensial WO HI berbeda. Akun cukup SELECT.
# WOHI_MYSQL_HOST=
# WOHI_MYSQL_PORT=3306
# WOHI_MYSQL_USER=
# WOHI_MYSQL_PASSWORD=
# WOHI_MYSQL_DATABASE=
