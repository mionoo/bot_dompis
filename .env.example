# Salin file ini ke .env lalu isi nilai sebenarnya.
# JANGAN pernah commit .env yang berisi kredensial asli ke git.

# ---- Server ----
PORT=3031

# ---- MongoDB ----
MONGO_URI=

# ---- Telegram bots (4 instance, satu per zona/wilayah) ----
Assist1_TOKEN=
Assist2_TOKEN=
Assist3_TOKEN=
Assist_SuraMadu_TOKEN=

# ID chat Telegram admin yang menerima notifikasi error dari bot.
# Sebelumnya nilai ini hardcode di adapters/telegram.js (68619032);
# sekarang bisa diisi/diubah di sini tanpa mengubah kode.
ADMIN_CHAT_ID=68619032

# ---- Webhook event tiket (routers/webhook.js -> modules/hookDompis) ----
TECH_EVENTS_WEBHOOK_ENABLED=
TECH_EVENTS_WEBHOOK_URL=
TECH_EVENTS_WEBHOOK_SECRET=
TECH_EVENTS_WEBHOOK_SECRET_2=

# ---- Cron scheduler (test.js) ----
CRON_ENABLED=
CRON_SECRET=

# ---- Google Sheets integration ----
GOOGLE_CREDENTIAL=
SPREADSHEET_ID=

# ---- Notifikasi umum ----
ADMIN_BOT=

# ---- Dipakai oleh scripts/teswebhook.js (opsional, ada fallback di kode) ----
TEST_WEBHOOK_URL=http://localhost:3031/webhook/dompis
